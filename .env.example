# =============================================
# TokTicKit – Environment Variables Example
# Copy this file to .env and fill in values
# =============================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://toktickit_user:toktickit_password@localhost:5432/toktickit_db?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
# Origin allowed to send/receive the toktickit_session cookie (CORS credentials require
# an exact origin, not '*').
CLIENT_URL=http://localhost:5173

# --- Authentication (Lab 3) ---
# Secret used to sign session JWTs (docs/lab-03/api-spec.md §0.1). Use a long random
# value in any real environment; never commit the actual secret.
JWT_SECRET=dev-only-change-me

# --- Client (Vite) ---
# Prefix with VITE_ to expose to the browser
VITE_API_URL=http://localhost:3000
