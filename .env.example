# =============================================
# TokTicKit – Environment Variables Example
# Copy this file to .env and fill in values
# =============================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://toktickit_user:toktickit_password@localhost:5432/toktickit_db?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Client (Vite) ---
# Prefix with VITE_ to expose to the browser
VITE_API_URL=http://localhost:3000
