# =============================================
# TokTickIT – Environment Variables Example
# Copy this file to .env and fill in values. Never commit .env.
# Placeholders only — no real password, key or connection string belongs here.
# Every variable is described in docs/labs/lab-05/deployment.md (§ Environment variables).
# =============================================

# --- Database (PostgreSQL) ---
# Local docker-compose database. On Cloud Run this comes from Secret Manager
# (toktickit-database-url) and points at Cloud SQL through /cloudsql/<connection name>.
DATABASE_URL="postgresql://toktickit_user:toktickit_password@localhost:5432/toktickit_db?schema=public"

# --- Server ---
PORT=3000
# development locally; Cloud Run sets production.
NODE_ENV=development
# Origin allowed to send/receive the toktickit_session cookie when the client runs on its own
# dev server (CORS credentials require an exact origin, not '*'). Not needed in production,
# where the API serves the SPA from the same origin.
CLIENT_URL=http://localhost:5173

# --- Authentication (Lab 3) ---
# Secret used to sign session JWTs (docs/lab-03/api-spec.md §0.1). Use a long random value in
# any real environment; on Cloud Run it comes from Secret Manager. Never commit the real secret.
JWT_SECRET=dev-only-change-me

# --- Seed (Lab 5) ---
# Each line starts with #, so copying this file changes nothing locally: the seed then uses the
# documented local initial password and loads demo data. In production (NODE_ENV=production)
# ADMIN_PASSWORD is required and demo data is off unless SEED_DEMO_DATA=true.
# First administrator's password (john.smith@toktickit.com, must change at first sign-in).
# ADMIN_PASSWORD=change-me-Str0ng!
# Demo users and sample tickets for UAT. Default: true locally, false in production.
# SEED_DEMO_DATA=false
# Password for every demo user (required when SEED_DEMO_DATA=true in production).
# DEMO_USER_PASSWORD=change-me-Str0ng!

# --- Production SPA (Lab 5, optional) ---
# Folder holding the built React app that Express serves when NODE_ENV=production.
# Default: <repo>/client/dist.
# CLIENT_DIST_DIR=/app/client/dist

# --- Client (Vite, build time) ---
# Prefix with VITE_ to expose to the browser. Unset → http://localhost:3000 (npm run dev).
# The production image builds with VITE_API_URL="" so the SPA calls the API on its own origin.
VITE_API_URL=http://localhost:3000
