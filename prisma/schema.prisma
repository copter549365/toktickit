// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Lab 3 — expanded 8-status lifecycle (was 6 in Lab 2)
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Lab 3 — unified user role
enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Lab 4 — Action Taken lifecycle (BR-07); COMPLETED and CANCELLED are locked
enum ActionTakenStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Lab 3 — replaces Lab 2 RequesterUser; absorbs all identities via migration
model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tickets             Ticket[]         @relation("requester")
  assignedTickets     Ticket[]         @relation("ticketOwner")
  publicComments      PublicComment[]
  internalNotes       InternalNote[]

  // Lab 4 — the four distinct Action Taken roles (spec §7.2 decision 4)
  assignedActions     ActionTaken[]        @relation("actionAssignee")
  performedActions    ActionTaken[]        @relation("actionPerformer")
  createdActions      ActionTaken[]        @relation("actionCreator")
  updatedActions      ActionTaken[]        @relation("actionUpdater")
  statusChanges       TicketStatusChange[]

  @@index([email])
  @@index([role])
}

model Ticket {
  id                        Int          @id @default(autoincrement())
  ticketNumber              String       @unique
  requesterId               Int
  requester                 User         @relation("requester", fields: [requesterId], references: [id])
  categoryId                Int
  category                  Category     @relation(fields: [categoryId], references: [id])
  relatedSystemId           Int
  relatedSystem             RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  summary                   String
  description               String
  requestedPriority         Priority
  itPriority                Priority?
  currentStatus             TicketStatus @default(NEW)
  ticketOwnerId             Int?
  ticketOwner               User?        @relation("ticketOwner", fields: [ticketOwnerId], references: [id])
  // Lab 3 — requester acknowledges resolution before CLOSED
  requesterResolvedIndicator Boolean     @default(false)
  // Lab 3 — captured by PATCH /api/staff/tickets/:id/status (BR-13)
  resolutionSummary         String?
  reopenReason              String?
  // Lab 4 — optimistic concurrency (BR-18) and "Recently Resolved" (BR-15, BR-22)
  version                   Int          @default(1)
  resolvedAt                DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  attachments               Attachment[]
  publicComments            PublicComment[]
  internalNotes             InternalNote[]
  actionsTaken              ActionTaken[]
  statusChanges             TicketStatusChange[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requesterId, createdAt])
  @@index([ticketOwnerId])
  @@index([currentStatus])
  // Lab 4 — dashboard queries (BR-22, BR-23)
  @@index([currentStatus, ticketOwnerId])
  @@index([requesterId, updatedAt])
  @@index([itPriority, currentStatus])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSizeBytes    Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?
  uploadedAt       DateTime  @default(now())

  @@index([ticketId])
}

// Lab 3 — visible to requester and IT staff; logged on ticket timeline
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

// Lab 3 — IT staff only; hidden from requester
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

// Lab 4 — shared work record under a Ticket (BR-01..BR-11); never deleted (BR-08)
model ActionTaken {
  id               Int               @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Idempotent create (BR-20)
  clientRequestId  String            @db.Uuid
  actionAt         DateTime
  description      String            @db.VarChar(2000)
  result           String?           @db.VarChar(2000)
  status           ActionTakenStatus @default(PLANNED)
  assigneeId       Int
  assignee         User              @relation("actionAssignee", fields: [assigneeId], references: [id])
  // Set automatically when the action enters COMPLETED (BR-05)
  performedById    Int?
  performedBy      User?             @relation("actionPerformer", fields: [performedById], references: [id])
  createdById      Int
  createdBy        User              @relation("actionCreator", fields: [createdById], references: [id])
  lastUpdatedById  Int
  lastUpdatedBy    User              @relation("actionUpdater", fields: [lastUpdatedById], references: [id])
  followUpRequired Boolean           @default(false)
  followUpNote     String?           @db.VarChar(1000)
  attachmentNotes  String?           @db.VarChar(1000)
  cancelReason     String?           @db.VarChar(500)
  completedAt      DateTime?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([ticketId, clientRequestId])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status])
}

// Lab 4 — append-only status history (BR-17)
model TicketStatusChange {
  id          Int           @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById Int?
  changedBy   User?         @relation(fields: [changedById], references: [id])
  note        String?       @db.VarChar(2000)
  isMigrated  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt, id])
}
